{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl events *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl auth can-i *)",
      "Bash(kubectl kustomize *)",
      "Bash(flux get *)",
      "Bash(flux logs *)",
      "Bash(flux tree *)",
      "Bash(kustomize build *)",
      "mcp__kubernetes",
      "mcp__github",
      "mcp__proxmox"
    ],
    "deny": [
      "Bash(kubectl delete *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl config *)",
      "Bash(kubectl *--kubeconfig*)",
      "Bash(flux reconcile *)",
      "Bash(flux suspend *)",
      "Read(~/.kube/config)",
      "Bash(cat ~/.kube/config*)",
      "Bash(cat /home/larma/.kube/config*)",
      "Read(~/.config/homelab-mcp/**)",
      "Bash(cat ~/.config/homelab-mcp/*)",
      "Bash(cat /home/larma/.config/homelab-mcp/*)"
    ]
  }
}
