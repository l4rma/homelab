# Secrets and local config (repo is public)
.claude/settings.local.json
*.agekey
kubeconfig*
*.kubeconfig
.env
tmp/

# Terraform: state and variables may contain secrets.
# .terraform.lock.hcl is intentionally NOT ignored; it must be committed.
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
*.auto.tfvars
crash.log
crash.*.log
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Hugo build output
hugo/public/
hugo/resources/_gen/
.hugo_build.lock

# Ansible
ansible/*.retry
.vault_pass*
